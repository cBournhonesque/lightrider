(
    arena: (
        width: 5000.0,
        height: 1600.0,
    ),
    movement: (
        tick_rate_hz: 32.0,
        starting_tail_length: 200.0,
        min_speed: 0.85,
        max_speed: 3.0,
        base_acceleration: -0.01,
        food_boost_acceleration: 0.012,
        food_boost_decay: 0.94,
        boost_acceleration_ratio: 2.0,
        boost_distance: 20.0,
    ),
    render: (
        use_assets: true,
        tail_width: 1.0,
        head_size: 6.0,
        map_outline_width: 3.0,
        background_tile_size: 128.0,
        normal_camera_scale: 0.35,
        normal_camera_growth_per_tail_length: 0.00015,
        normal_camera_scale_smoothing: 6.0,
        normal_camera_max_scale: 0.62,
        debug_camera_scale: 1.0,
    ),
    sound: (
        enabled: true,
        master_volume: 1.0,
        background_volume: 0.0,
        death_volume: 0.55,
        food_volume: 0.65,
        turn_volume: 0.16,
        proximity_boost_volume: 0.2,
        electro_loop_volume: 0.85,
        spatial_audio: true,
        spatial_scale: 0.02,
        spatial_listener_ear_gap: 8.0,
        remote_sound_full_volume_distance: 60.0,
        remote_sound_max_distance: 360.0,
        remote_death_volume: 1.35,
        remote_food_volume: 0.75,
        remote_turn_volume: 1.15,
        remote_proximity_boost_volume: 0.85,
        remote_speed_volume: 0.75,
        speed_loop_start_speed: 1.2,
        speed_loop_min_volume: 0.12,
        speed_loop_max_volume: 1.0,
        speed_fast_loop_start_speed: 2.55,
        speed_fast_loop_volume: 1.4,
    ),
    food: (
        target_count: 400,
        max_count: 600,
        spawn_interval_seconds: 0.05,
        visual_radius: 2.4,
        radius: 45.0,
        tail_growth: 20.0,
        death_food_spacing: 18.0,
        death_food_max: 120,
    ),
    rooms: (
        max_rooms: 16,
        max_players_per_room: 50,
    ),
    bots: (
        enabled: false,
        target_count_per_room: 0,
        decision_interval_ticks: 10,
        max_turns_per_second: 6,
        mistake_chance_per_decision_percent: 3,
    ),
    fake_clients: (
        enabled: false,
        count: 0,
        input_interval_ticks: 10,
        mistake_chance_per_decision_percent: 3,
    ),
    respawn: (
        player_cooldown_seconds: 3.0,
        bot_cooldown_seconds: 1.0,
    ),
    network: (
        server_port: 5000,
        // Server state snapshots are sent at 16 Hz while simulation runs at 32 Hz.
        replication_send_hz: 16,
        compression: Disabled,
        // Input delay: cover roughly 60ms at 32Hz with delay first,
        // then predict up to 8 additional ticks for remaining latency.
        input_delay: (
            minimum_input_delay_ticks: 0,
            maximum_input_delay_before_prediction_ticks: 2,
            maximum_predicted_ticks: 8,
        ),
        interpolation_delay: (
            min_delay_ms: 5,
            send_interval_ratio: 1.7,
        ),
        lag_compensation: (
            enabled: false,
            max_delay_ticks: 10,
        ),
        input_packet_redundancy_ticks: 3,
        artificial_latency_ms: 0,
        artificial_jitter_ms: 0,
        artificial_loss_percent: 0,
    ),
    debug: (
        lightyear_debug: false,
        json_snapshots: false,
        snake_trace_sample_interval_ticks: 1,
        invariant_checks: true,
    ),
)
