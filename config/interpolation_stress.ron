(
    arena: (
        width: 5000.0,
        height: 1600.0,
    ),
    movement: (
        tick_rate_hz: 32.0,
        starting_tail_length: 200.0,
        min_speed: 3.0,
        max_speed: 3.0,
        base_acceleration: 0.0,
        food_boost_acceleration: 0.0,
        food_boost_decay: 1.0,
        boost_acceleration_ratio: 1.0,
        boost_distance: 20.0,
    ),
    render: (
        use_assets: false,
        tail_width: 1.25,
        head_size: 6.0,
        map_outline_width: 3.0,
        background_tile_size: 128.0,
        normal_camera_scale: 0.24,
        normal_camera_growth_per_tail_length: 0.00005,
        normal_camera_scale_smoothing: 6.0,
        normal_camera_max_scale: 0.46,
        debug_camera_scale: 1.0,
    ),
    sound: (
        enabled: false,
        master_volume: 1.0,
        background_volume: 0.0,
        death_volume: 0.55,
        food_volume: 0.65,
        electro_loop_volume: 0.85,
        spatial_audio: false,
        spatial_scale: 0.02,
        spatial_listener_ear_gap: 8.0,
        remote_sound_full_volume_distance: 60.0,
        remote_sound_max_distance: 360.0,
        remote_one_shot_max_distance: 240.0,
        remote_death_volume: 1.35,
        remote_food_volume: 0.75,
        remote_turn_volume: 1.15,
        remote_proximity_boost_volume: 0.85,
        remote_speed_volume: 0.75,
        speed_loop_start_speed: 0.85,
        speed_loop_min_volume: 0.12,
        speed_loop_max_volume: 1.0,
        speed_fast_loop_start_speed: 2.55,
        speed_fast_loop_volume: 1.4,
    ),
    food: (
        target_count: 0,
        max_count: 0,
        spawn_interval_seconds: 0.05,
        visual_radius: 3.2,
        radius: 45.0,
        tail_growth: 20.0,
        death_food_spacing: 10.0,
        death_food_max: 0,
    ),
    rooms: (
        max_rooms: 2,
        max_players_per_room: 8,
    ),
    bots: (
        enabled: false,
        target_count_per_room: 0,
        minimum_total_players_per_room: 5,
        decision_interval_ticks: 1,
        max_turns_per_second: 6,
        mistake_chance_per_decision_percent: 100,
    ),
    fake_clients: (
        enabled: false,
        count: 0,
        input_interval_ticks: 1,
        mistake_chance_per_decision_percent: 100,
    ),
    respawn: (
        player_cooldown_seconds: 1.0,
        bot_cooldown_seconds: 1.0,
    ),
    network: (
        server_port: 5000,
        replication_send_hz: 16,
        compression: Disabled,
        interest: (
            enabled: true,
            fallback_screen_width: 1920,
            fallback_screen_height: 1080,
            max_screen_width: 3840,
            max_screen_height: 2160,
            view_margin: 200.0,
            hysteresis_margin: 250.0,
            metrics_interval_seconds: 5.0,
            update_interval_ticks: 1,
        ),
        input_delay: (
            minimum_input_delay_ticks: 0,
            maximum_input_delay_before_prediction_ticks: 3,
            maximum_predicted_ticks: 16,
            maximum_input_delay_ticks: 6,
        ),
        interpolation_delay: (
            min_delay_ms: 500,
            send_interval_ratio: 1.7,
        ),
        lag_compensation: (
            enabled: false,
            max_delay_ticks: 10,
        ),
        input_packet_redundancy_ticks: 5,
        artificial_latency_ms: 45,
        artificial_jitter_ms: 70,
        artificial_loss_percent: 6,
    ),
    debug: (
        lightyear_debug: true,
        json_snapshots: true,
        snake_trace_sample_interval_ticks: 1,
        invariant_checks: true,
    ),
)
