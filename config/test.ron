(
    arena: (
        width: 800.0,
        height: 600.0,
    ),
    movement: (
        tick_rate_hz: 30.0,
        starting_tail_length: 80.0,
        min_speed: 1.0,
        max_speed: 4.0,
        base_acceleration: -0.01,
        food_boost_acceleration: 0.08,
        food_boost_decay: 0.85,
        boost_acceleration_ratio: 2.0,
        boost_distance: 20.0,
    ),
    render: (
        tail_width: 3.0,
        head_size: 10.0,
        map_outline_width: 3.0,
        normal_camera_scale: 1.0,
        debug_camera_scale: 4.0,
    ),
    food: (
        target_count: 20,
        spawn_interval_seconds: 0.25,
        radius: 20.0,
        tail_growth: 20.0,
    ),
    rooms: (
        max_rooms: 2,
        max_players_per_room: 8,
    ),
    bots: (
        enabled: true,
        target_count_per_room: 4,
        decision_interval_ticks: 5,
        mistake_chance_per_decision_percent: 3,
    ),
    fake_clients: (
        enabled: false,
        count: 0,
        input_interval_ticks: 5,
        mistake_chance_per_decision_percent: 3,
    ),
    respawn: (
        player_cooldown_seconds: 1.0,
        bot_cooldown_seconds: 1.0,
    ),
    network: (
        server_port: 5000,
        input_delay: (
            minimum_input_delay_ticks: 0,
            maximum_input_delay_before_prediction_ticks: 3,
            maximum_predicted_ticks: 7,
        ),
        input_packet_redundancy_ticks: 3,
        artificial_latency_ms: 0,
        artificial_jitter_ms: 0,
        artificial_loss_percent: 0,
    ),
    debug: (
        lightyear_debug: true,
        json_snapshots: true,
        snake_trace_sample_interval_ticks: 1,
        invariant_checks: true,
    ),
)
