(
    arena: (
        width: 800.0,
        height: 600.0,
    ),
    movement: (
        tick_rate_hz: 32.0,
        starting_tail_length: 80.0,
        min_speed: 0.85,
        max_speed: 2.45,
        base_acceleration: -0.01,
        food_boost_acceleration: 0.008,
        food_boost_decay: 0.94,
        boost_acceleration_ratio: 1.35,
        boost_distance: 14.0,
        acceleration_smoothing: 0.16,
    ),
    render: (
        use_assets: true,
        tail_width: 1.25,
        head_size: 6.0,
        map_outline_width: 3.0,
        background_tile_size: 128.0,
        normal_camera_scale: 0.12,
        normal_camera_growth_per_tail_length: 0.00005,
        normal_camera_scale_smoothing: 6.0,
        normal_camera_max_scale: 0.46,
        debug_camera_scale: 1.0,
    ),
    sound: (
        enabled: true,
        master_volume: 1.0,
        background_volume: 0.0,
        death_volume: 0.55,
        food_volume: 0.65,
        turn_volume: 0.52,
        proximity_boost_volume: 0.2,
        electro_loop_volume: 0.92,
        spatial_audio: true,
        spatial_scale: 0.02,
        spatial_listener_ear_gap: 8.0,
        remote_sound_full_volume_distance: 45.0,
        remote_sound_max_distance: 300.0,
        remote_one_shot_max_distance: 200.0,
        remote_death_volume: 1.35,
        remote_food_volume: 0.75,
        remote_turn_volume: 1.15,
        remote_proximity_boost_volume: 0.85,
        remote_speed_volume: 0.75,
        speed_loop_start_speed: 0.85,
        speed_loop_min_volume: 0.38,
        speed_loop_max_volume: 1.0,
        speed_fast_loop_start_speed: 2.08,
        speed_fast_loop_volume: 1.4,
    ),
    food: (
        target_count: 75,
        max_count: 100,
        spawn_interval_seconds: 0.05,
        visual_radius: 1.1,
        radius: 22.5,
        tail_growth: 20.0,
        death_food_spacing: 6.5,
        death_food_max: 130,
    ),
    rooms: (
        max_rooms: 2,
        max_players_per_room: 8,
    ),
    bots: (
        enabled: true,
        target_count_per_room: 3,
        minimum_total_players_per_room: 4,
        decision_interval_ticks: 5,
        max_turns_per_second: 5,
        mistake_chance_per_decision_percent: 3,
    ),
    fake_clients: (
        enabled: false,
        count: 0,
        input_interval_ticks: 5,
        mistake_chance_per_decision_percent: 3,
    ),
    respawn: (
        player_cooldown_seconds: 3.0,
        bot_cooldown_seconds: 1.0,
    ),
    network: (
        server_port: 5000,
        // Server state snapshots are sent at 16 Hz while simulation runs at 32 Hz.
        replication_send_hz: 16,
        compression: Disabled,
        interest: (
            enabled: true,
            fallback_screen_width: 1920,
            fallback_screen_height: 1080,
            max_screen_width: 3840,
            max_screen_height: 2160,
            view_margin: 200.0,
            hysteresis_margin: 250.0,
            metrics_interval_seconds: 5.0,
            update_interval_ticks: 1,
        ),
        // Input delay: delay up to 3 ticks first, predict up to 10 ticks,
        // then add more input delay up to 6 total ticks before disconnecting.
        input_delay: (
            minimum_input_delay_ticks: 0,
            maximum_input_delay_before_prediction_ticks: 3,
            maximum_predicted_ticks: 10,
            maximum_input_delay_ticks: 6,
        ),
        interpolation_delay: (
            min_delay_ms: 5,
            send_interval_ratio: 1.7,
        ),
        lag_compensation: (
            enabled: false,
            max_delay_ticks: 10,
        ),
        input_packet_redundancy_ticks: 3,
        artificial_latency_ms: 0,
        artificial_jitter_ms: 0,
        artificial_loss_percent: 0,
    ),
    debug: (
        lightyear_debug: true,
        json_snapshots: true,
        snake_trace_sample_interval_ticks: 1,
        invariant_checks: true,
    ),
)
